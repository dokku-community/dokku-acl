#!/usr/bin/env bash
source "$PLUGIN_CORE_AVAILABLE_PATH/common/functions"
source "$PLUGIN_CORE_AVAILABLE_PATH/common/property-functions"
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x

cmd-acl-report-all() {
  declare desc="displays a acl report for one or more apps"
  local cmd="acl:report"
  local APP="$1" INFO_FLAG="$2"
  local INSTALLED_APPS

  if [[ -n "$APP" ]] && [[ "$APP" == --* ]]; then
    INFO_FLAG="$APP"
    APP=""
  fi

  if [[ -z "$APP" ]] && [[ -z "$INFO_FLAG" ]]; then
    INFO_FLAG="true"
  fi

  if [[ -z "$APP" ]]; then
    INSTALLED_APPS=$(dokku_apps)
    for app in $INSTALLED_APPS; do
      cmd-acl-report-single "$app" "$INFO_FLAG" | tee || true
    done
  else
    cmd-acl-report-single "$APP" "$INFO_FLAG"
  fi
}

cmd-acl-report-single() {
  declare APP="$1" INFO_FLAG="$2"
  if [[ "$INFO_FLAG" == "true" ]]; then
    INFO_FLAG=""
  fi
  verify_app_name "$APP"
  # load here rather than inside the substitutions below, which run in
  # subshells that would each reload the properties
  fn-acl-load-global-properties
  local flag_map=(
    "--acl-allowed-users: $(fn-acl-allowed-users "$APP")"
    "--acl-global-allow-command-line: $(fn-acl-allow-command-line && echo true || echo false)"
    "--acl-global-super-user: $(fn-acl-global-property super-user)"
    "--acl-global-user-commands: $(fn-acl-global-property user-commands)"
    "--acl-global-per-app-commands: $(fn-acl-global-property per-app-commands)"
    "--acl-global-per-service-commands: $(fn-acl-global-property per-service-commands)"
    "--acl-global-link-commands: $(fn-acl-global-property link-commands)"
  )

  if [[ -z "$INFO_FLAG" ]]; then
    dokku_log_info2_quiet "${APP} acl information"
    for flag in "${flag_map[@]}"; do
      key="$(echo "${flag#--}" | cut -f1 -d' ' | tr - ' ')"
      dokku_log_verbose "$(printf "%-30s %-25s" "${key^}" "${flag#*: }")"
    done
  else
    local match=false
    local valid_flags=""
    for flag in "${flag_map[@]}"; do
      valid_flags="${valid_flags} $(echo "$flag" | cut -d':' -f1)"
      if [[ "$flag" == "${INFO_FLAG}:"* ]]; then
        value=${flag#*: }
        # an unset value is a valid answer, so print it (possibly empty) and succeed
        [[ -n "$value" ]] && echo "$value"
        match=true
      fi
    done
    [[ "$match" == "true" ]] || dokku_log_fail "Invalid flag passed, valid flags:${valid_flags}"
  fi
}

fn-acl-allowed-users() {
  declare desc="print the space-separated users in the acl for an app"
  declare APP="$1"
  local ACL_PATH="$DOKKU_ROOT/$APP/acl"

  [[ -d "$ACL_PATH" ]] || return 0
  find "$ACL_PATH" -mindepth 1 -maxdepth 1 -type f -printf "%f\n" | sort | xargs
}

fn-acl-check-local() {
  declare desc="fail unless the command is run locally rather than over ssh"

  if [[ -n "${NAME:-}" ]]; then
    dokku_log_fail "You can only modify ACL using local dokku command on target host"
  fi
}

fn-acl-check-app() {
  declare APP="$1"

  verify_app_name "$APP"
  fn-acl-check-local
}

fn-acl-check-service() {
  declare SERVICE_TYPE="$1" SERVICE="$2"

  local SERVICE_PATH="$DOKKU_LIB_ROOT/services/$SERVICE_TYPE/$SERVICE"
  if ! [[ -d $SERVICE_PATH ]]; then
    dokku_log_fail "Service $SERVICE of type $SERVICE_TYPE does not exist"
  fi

  fn-acl-check-local
}

fn-acl-validate-user() {
  declare desc="fail unless the user name is safe to use as a file in an acl directory"
  declare USERNAME="$1"

  if [[ -z "$USERNAME" ]] || [[ "$USERNAME" == *"/"* ]] || [[ "$USERNAME" == "." ]] || [[ "$USERNAME" == ".." ]]; then
    dokku_log_fail "Invalid user name: $USERNAME"
  fi
}

fn-acl-set-users() {
  declare desc="replace the users in an acl directory with the given users"
  declare ACL_PATH="$1"
  shift 1
  local user acl_file
  local -A users=()

  # validate every user before touching the acl so a bad name never leaves a
  # half-written list behind
  for user in "$@"; do
    fn-acl-validate-user "$user"
    users["u:$user"]=1
  done

  if [[ ${#users[@]} -eq 0 ]]; then
    rm -rf "$ACL_PATH"
    return
  fi

  # an absent acl directory means the app or service is unrestricted, so
  # create it before anything else, and revoke before granting so an
  # interrupted run never keeps a user that was meant to be removed
  mkdir -p "$ACL_PATH"
  for acl_file in "$ACL_PATH"/* "$ACL_PATH"/.[!.]* "$ACL_PATH"/..?*; do
    [[ -e "$acl_file" ]] || continue
    [[ -n "${users["u:${acl_file##*/}"]:-}" ]] || rm -rf "$acl_file"
  done

  for user in "${!users[@]}"; do
    touch "$ACL_PATH/${user#u:}"
  done
}

fn-check-app-acl() {
  declare desc="Checks if the current user has an ACL entry for the app"
  declare APP="$1" SSH_NAME="$2"
  local ACL_FILE="$DOKKU_ROOT/$APP/acl/$SSH_NAME"

  if ! (verify_app_name "$APP" 2>/dev/null); then
    dokku_log_fail "User $SSH_NAME does not have permissions to run $CMD on $APP, or $APP does not exist"
  fi

  [[ -f "$ACL_FILE" ]] && return 0

  dokku_log_fail "User $SSH_NAME does not have permissions to run $CMD on $APP, or $APP does not exist"
}

fn-check-service-acl() {
  declare desc="Checks if the current user has an ACL entry for the service"
  declare CMD="$1" SERVICE="$2" SSH_NAME="$3"

  local SERVICE_TYPE="${CMD%%:*}"
  local SERVICE_PATH="$DOKKU_LIB_ROOT/services/$SERVICE_TYPE/$SERVICE"
  local ACL_FILE="$SERVICE_PATH/acl/$SSH_NAME"

  if ! [[ -d $SERVICE_PATH ]]; then
    dokku_log_fail "User $SSH_NAME does not have permissions to run $CMD on $SERVICE, or $SERVICE does not exist"
  fi

  [[ -f "$ACL_FILE" ]] && return 0

  dokku_log_fail "User $SSH_NAME does not have permissions to run $CMD on $SERVICE, or $SERVICE does not exist"
}

fn-check-modify-app-acl() {
  declare desc="Checks if the current dokku user is allowed to modify the given app"
  declare APP="$1"

  local ACL="$DOKKU_ROOT/$APP/acl"
  local SUPER_USER

  fn-acl-load-global-properties
  SUPER_USER="$(fn-acl-global-property super-user)"

  if fn-acl-is-command-line; then
    if ! fn-acl-allow-command-line; then
      # Command line usage was explicitly disabled, so only allow it when
      # there is no super user.

      [[ -z "$SUPER_USER" ]] && exit 0

      dokku_log_fail "It appears that you're running this command from the command" \
        "line, which is disabled because the acl allow-command-line property" \
        "is set to false.  Run 'sudo dokku acl:set --global allow-command-line true'" \
        "to enable command line usage."
    fi

    exit 0
  fi

  if [[ ! -d "$ACL" ]]; then
    if [[ -n "$SUPER_USER" ]] && ! fn-acl-is-super-user "$NAME"; then
      dokku_log_fail "Only $(fn-acl-super-users-list) can modify a repository if the ACL is empty"
    fi

    exit 0 # all good, there are no restrictions
  fi

  local ACL_FILE="$ACL/$NAME"

  if [[ ! -f "$ACL_FILE" ]] && ! fn-acl-is-super-user "$NAME"; then
    echo "User $NAME does not have permissions to modify this repository" >&2
    exit 2
  fi
}

fn-acl-is-command-line() {
  declare desc="check if the current dokku command was run from the command line"

  # Only ssh connections set $NAME. dokku core authenticates everything else,
  # such as cron jobs and systemd services, as the "default" SSH_NAME, but it
  # does not export NAME, so hooks and nested dokku calls still see it empty.
  [[ -z "${NAME:-}" ]]
}

fn-acl-allow-command-line() {
  declare desc="check if dokku commands may modify apps from the command line"

  [[ "$(fn-acl-global-property allow-command-line)" != "false" ]]
}

fn-acl-is-super-user() {
  declare desc="check if the specified user is a super user"
  declare USERNAME="$1"
  local super_user

  for super_user in $(fn-acl-global-property super-user); do
    if [[ "$USERNAME" == "$super_user" ]]; then
      return
    fi
  done

  return 1
}

fn-acl-super-users-list() {
  declare desc="print the super users as a comma-separated list"
  local super_users list

  read -ra super_users <<<"$(fn-acl-global-property super-user)"
  printf -v list '%s, ' "${super_users[@]}"
  echo "${list%, }"
}

fn-acl-load-global-properties() {
  declare desc="read every global acl property into ACL_GLOBAL_PROPERTIES"
  local key value properties

  # fail closed: treating an unreadable store as empty would lift every
  # restriction
  if ! properties="$(fn-plugin-property-get-all "acl" "--global")"; then
    dokku_log_fail "Unable to read the global acl properties"
  fi

  # a global so the values survive the function call; callers must not run
  # this in a subshell, or every lookup reloads the properties
  declare -gA ACL_GLOBAL_PROPERTIES=()
  while read -r key value; do
    [[ -n "$key" ]] && ACL_GLOBAL_PROPERTIES["$key"]="$value"
  done <<<"$properties"
  ACL_GLOBAL_PROPERTIES_LOADED=true
}

fn-acl-global-property() {
  declare desc="print the value of a global acl property"
  declare KEY="$1"

  [[ "${ACL_GLOBAL_PROPERTIES_LOADED:-}" == "true" ]] || fn-acl-load-global-properties
  echo "${ACL_GLOBAL_PROPERTIES["$KEY"]:-}"
}

fn-acl-migrate-dokkurc() {
  declare desc="import the global settings from the dokkurc into properties once"
  local key var value migrated=false

  fn-plugin-property-exists "acl" "--global" "dokkurc-migrated" && return 0

  for key in super-user allow-command-line user-commands per-app-commands per-service-commands link-commands; do
    if [[ "$key" == "super-user" ]]; then
      var="DOKKU_SUPER_USER"
    else
      var="DOKKU_ACL_${key//-/_}"
      var="${var^^}"
    fi

    value="${!var:-}"
    [[ -n "$value" ]] || continue
    fn-plugin-property-exists "acl" "--global" "$key" && continue

    if [[ "$key" == "allow-command-line" ]]; then
      case "${value,,}" in
        0 | false | no | off) value="false" ;;
        *) value="true" ;;
      esac
    fi

    fn-plugin-property-write "acl" "--global" "$key" "$value"
    dokku_log_info1 "Migrated $var to the acl $key property"
    migrated=true
  done

  fn-plugin-property-write "acl" "--global" "dokkurc-migrated" "true"
  if [[ "$migrated" == "true" ]]; then
    dokku_log_warn "Global acl settings are now managed with 'dokku acl:set --global'"
    dokku_log_warn "The DOKKU_SUPER_USER and DOKKU_ACL_* variables are no longer read and can be removed from ~dokku/.dokkurc/acl"
  fi
}
