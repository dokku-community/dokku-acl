#!/usr/bin/env bash
source "$(dirname "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)")/config"
set -eo pipefail
[[ $DOKKU_TRACE ]] && set -x
source "$PLUGIN_BASE_PATH/common/functions"
source "$(dirname "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)")/internal-functions"

cmd-acl-allowed() {
  #E show apps that the admin user has access to
  #E dokku $PLUGIN_COMMAND_PREFIX:allowed admin
  #A username, user to check for access
  declare desc="list apps the user has access to"
  local cmd="$PLUGIN_COMMAND_PREFIX:allowed" argv=("$@")
  [[ ${argv[0]} == "$cmd" ]] && shift 1
  declare USERNAME="$1"

  if [[ -n "${NAME:-}" ]]; then
    dokku_log_fail "This command can only be run using the local dokku command on the target host"
  fi

  if [[ -z "$USERNAME" ]]; then
    dokku_log_fail "No username specified"
  fi

  if fn-acl-is-super-user "$USERNAME"; then
    dokku_apps
    return
  fi

  # glob on absolute paths rather than changing directory: returning to the
  # caller's working directory fails when the dokku user cannot access it
  local acl_file entry
  for acl_file in "$DOKKU_ROOT"/*/acl/"$USERNAME"; do
    [[ -f "$acl_file" ]] || continue
    entry="${acl_file#"$DOKKU_ROOT/"}"
    echo "${entry%%/*}"
  done
}

cmd-acl-allowed "$@"
